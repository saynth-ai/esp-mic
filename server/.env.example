# ---------------------------------------------------------------- security
# Shared secret each ESP32 sends as "Authorization: Bearer <token>" when it
# opens the WebSocket. Must match DEVICE_TOKEN in the firmware.
# Generate one with:  openssl rand -hex 24
# Several comma-separated tokens are accepted (for rotating without downtime).
DEVICE_TOKEN=change-this-token

# Browser origins allowed to call the REST API / dashboard WebSocket from
# another site. Empty = same-origin only (the built-in dashboard always works).
# Example: CORS_ORIGINS=https://ops.example.com,http://localhost:5173   or  *
CORS_ORIGINS=

# Set to true when behind nginx/Caddy/Traefik so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# ------------------------------------------------------------------ server
HOST=0.0.0.0
PORT=8080
# WebSocket path devices connect to (SERVER_PATH in the firmware).
DEVICE_WS_PATH=/audio
LOG_LEVEL=info

# ---------------------------------------------------------------- recordings
RECORDINGS_DIR=./recordings
# Timezone used for recording filenames (e.g. Asia/Dhaka, Europe/Berlin).
TZ=UTC
# No audio for this long → the current recording is finalized.
AUDIO_TIMEOUT_MS=3000
# How often audio is written to disk and the WAV header fsynced.
# A server crash loses at most this much audio.
FLUSH_INTERVAL_MS=1000
# Split long sessions into files of at most this many seconds (0 = never).
MAX_RECORDING_SECONDS=3600
# Storage format of finished recordings. Recording always happens as WAV
# (crash-safe); with mp3 each finished file is converted in the background by
# LAME and the WAV deleted. 16 kHz mono WAV ≈ 115 MB/hour, MP3 32 kbps ≈ 14 MB/hour.
RECORDING_FORMAT=mp3
# kbps, constant bitrate: 16 (small, speech only) · 24 · 32 (default) · 48 · 64
MP3_BITRATE=32
# LAME binary (installed in the Docker image; apt install lame / brew install lame otherwise)
LAME_PATH=lame

# -------------------------------------------------------------------- audio
# Must match AUDIO_SAMPLE_RATE in the firmware. Format is always PCM s16le mono.
SAMPLE_RATE=16000
MAX_FRAME_BYTES=65536

# ------------------------------------------------------------------- timing
HELLO_TIMEOUT_MS=5000
PING_INTERVAL_MS=10000
STATUS_INTERVAL_MS=250
