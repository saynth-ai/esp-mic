# Production settings for live.patoari.com — copy to .env.production and fill in.
# Generate secrets with:  openssl rand -hex 24

# Dashboard login (fixed admin account)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs session cookies; changing it (or the password) logs everyone out.
SESSION_SECRET=change-me
SESSION_TTL_HOURS=168

# Shared secret the ESP32s send when connecting (must match the firmware's DEVICE_TOKEN).
DEVICE_TOKEN=change-me

# Behind Cloudflare + nginx: trust X-Forwarded-* for client IPs and HTTPS detection.
TRUST_PROXY=true
CORS_ORIGINS=

TZ=Asia/Dhaka
LOG_LEVEL=info

AUDIO_TIMEOUT_MS=10000
FLUSH_INTERVAL_MS=1000
MAX_RECORDING_SECONDS=3600
RECORDING_FORMAT=mp3
MP3_BITRATE=32
SAMPLE_RATE=16000
